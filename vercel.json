{
    "version": 2,
    "buildCommand": "npm install && npm run build",
    "outputDirectory": "dist",
    "installCommand": "npm install --production=false",
    "framework": "vite",
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/assets/$1",
            "headers": {
                "Cache-Control": "public, max-age=31536000, immutable"
            }
        },
        {
            "src": "/config/(.*)",
            "dest": "/config/$1"
        },
        {
            "src": "/services/(.*)",
            "dest": "/services/$1"
        },
        {
            "src": "/client/(.*)",
            "dest": "/client.html"
        },
        {
            "src": "/dashboard",
            "dest": "/dashboard.html"
        },
        {
            "src": "/devices",
            "dest": "/devices.html"
        },
        {
            "src": "/camera",
            "dest": "/camera.html"
        },
        {
            "src": "/settings",
            "dest": "/settings.html"
        },
        {
            "src": "/login",
            "dest": "/login.html"
        },
        {
            "src": "/",
            "dest": "/login.html"
        },
        {
            "src": "/(.*)",
            "dest": "/404.html",
            "status": 404
        }
    ]
}
